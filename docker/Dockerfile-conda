# RTAP — Real-Time Autonomous Perception (AGPL-3.0)

# Builds rtap/rtap:latest-conda image on DockerHub 
# Image is optimized for RTAP Anaconda ( installation and usage

# Start FROM miniconda3 image https://hub.docker.com/r/continuumio/miniconda3
FROM continuumio/miniconda3:latest

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1

# Downloads to user config dir
ADD  \
     \
    /root/.config/RTAP/

# Install linux packages and conda packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends libgl1 && \
    apt-get clean && \
    # Install conda packages
    # mkl required to fix 'OSError: libmkl_intel_lp64.so.2: cannot open shared object file: No such file or directory'
    conda config --set solver libmamba && \
    conda install -y pytorch torchvision pytorch-cuda=12.1 -c pytorch -c nvidia && \
    conda install -y -c conda-forge rtap mkl && \
    conda clean -afy && \
    # Remove extra build files
    rm -rf /var/lib/apt/lists/* /root/.config/RTAP/persistent_cache.json

# Copy model
ADD  .

# Usage --------------------------------------------------------------------------------------------------------------

# Production builds: 
# Example (build): t=rtap/rtap:latest-conda && docker build -f docker/Dockerfile-conda -t $t .
# Example (push): docker push $t
# Example (pull): t=rtap/rtap:latest-conda && docker pull $t
# Example (run): docker run -it --ipc=host --device nvidia.com/gpu=all $t
# Example (run-with-volume): docker run -it --ipc=host --device nvidia.com/gpu=all -v "$PWD/shared/datasets:/datasets" $t
# CDI requires Docker >= 28.2.0 and nvidia-container-toolkit >= 1.18.
# Legacy --gpus all can lose GPU access after host systemd daemon reloads (nvidia-container-toolkit#48).
