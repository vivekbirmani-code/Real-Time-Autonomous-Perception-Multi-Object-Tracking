# RTAP — Real-Time Autonomous Perception (AGPL-3.0)

# Builds rtap/rtap:latest-cpu image on DockerHub 
# Lightweight CPU image optimized for inference (extends latest-python)

# Build from RTAP Python image
FROM rtap/rtap:latest-python

# Set default command to bash
CMD ["/bin/bash"]

# Usage --------------------------------------------------------------------------------------------------------------

# Production builds: 
# Example (build): t=rtap/rtap:latest-cpu && docker build -f docker/Dockerfile-cpu -t $t .
# Example (push): docker push $t
# Example (pull): t=rtap/rtap:latest-cpu && docker pull $t
# Example (run): docker run -it --ipc=host $t
# Example (run-with-volume): docker run -it --ipc=host -v "$PWD/shared/datasets:/datasets" $t
