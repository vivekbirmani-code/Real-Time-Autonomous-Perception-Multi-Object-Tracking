# RTAP — Real-Time Autonomous Perception (AGPL-3.0)

# Builds rtap/rtap:latest-export image on DockerHub 
# Export-optimized derivative of rtap/rtap:latest for testing and benchmarks
# Includes all export format dependencies and pre-installed export packages

FROM rtap/rtap:latest

# Install export dependencies
# Numpy 1.26.4 required for TensorFlow export compatibility
# onnxruntime-gpu pinned <1.27.0 as 1.27.0 dropped CUDA 12 support and ships CUDA 13 binaries (base image is CUDA 12.8)
# Note tensorrt installed on-demand as depends on runtime environment CUDA version
RUN uv pip install --system --no-cache -e ".[export]" numpy==1.26.4 && \
    uv pip install --system --no-cache "onnxruntime-gpu<1.27.0" paddlepaddle x2paddle numpy==1.26.4 && \
    rm -rf tmp ~/.cache /root/.config/RTAP/persistent_cache.json

# Usage --------------------------------------------------------------------------------------------------------------

# Production builds: 
# Example (build): t=rtap/rtap:latest-export && docker build -f docker/Dockerfile-export -t $t .
# Example (push): docker push $t
# Example (pull): t=rtap/rtap:latest-export && docker pull $t
# Example (run): docker run -it --ipc=host --device nvidia.com/gpu=all $t
# Example (run-with-volume): docker run -it --ipc=host --device nvidia.com/gpu=all -v "$PWD/shared/datasets:/datasets" $t
# CDI requires Docker >= 28.2.0 and nvidia-container-toolkit >= 1.18.
# Legacy --gpus all can lose GPU access after host systemd daemon reloads (nvidia-container-toolkit#48).
