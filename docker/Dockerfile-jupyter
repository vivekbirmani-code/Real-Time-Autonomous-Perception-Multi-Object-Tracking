# RTAP — Real-Time Autonomous Perception (AGPL-3.0)

# Builds rtap/rtap:latest-jupyter image on DockerHub 
# Image provides JupyterLab interface for interactive YOLO development and includes tutorial notebooks

# Start from Python-based RTAP image for full Python environment
FROM rtap/rtap:latest-python

# Install JupyterLab for interactive development
RUN uv pip install --system jupyterlab && \
    # Create persistent data directory structure
    mkdir -p /data/{datasets,weights,runs} && \
    # Configure YOLO directories
    rtap settings datasets_dir="/data/datasets" weights_dir="/data/weights" runs_dir="/data/runs" && \
    rm -rf tmp /root/.config/RTAP/persistent_cache.json

# Start JupyterLab with tutorial notebook
ENTRYPOINT ["/usr/local/bin/jupyter", "lab", "--allow-root", "--ip=0.0.0.0", "/rtap/examples/tutorial.ipynb"]

# Usage --------------------------------------------------------------------------------------------------------------

# Production builds: 
# Example (build): t=rtap/rtap:latest-jupyter && docker build -f docker/Dockerfile-jupyter -t $t .
# Example (push): docker push $t
# Example (pull): t=rtap/rtap:latest-jupyter && docker pull $t
# Example (run): docker run -it --ipc=host -p 8888:8888 $t
# Example (run-with-volume): docker run -it --ipc=host -p 8888:8888 -v "$PWD/datasets:/data/datasets" $t
