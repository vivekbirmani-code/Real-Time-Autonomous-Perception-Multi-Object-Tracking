# RTAP — Real-Time Autonomous Perception (AGPL-3.0)

# Builds rtap/rtap:latest-nvidia-arm64 image on DockerHub 
# Supports JetPack 7.0 and DGX OS for YOLO on Jetson AGX Thor (T5000) and DGX Spark

# Start FROM PyTorch image nvcr.io/nvidia/pytorch:25.10-py3
FROM nvcr.io/nvidia/pytorch:25.10-py3

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    UV_BREAK_SYSTEM_PACKAGES=1

# Downloads to user config dir
ADD  \
     \
    /root/.config/RTAP/

# Install linux packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends libgl1 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Create working directory
WORKDIR /rtap

# Copy contents and configure dependencies
COPY . .
RUN sed -i'' -e 's/"opencv-python/"opencv-python-headless/' pyproject.toml
ADD  .

# Install pip packages (uv already installed in base image)
RUN uv pip install --system \
     && \
    # Reinstall torch and torchvision to ensure CUDA 13.0 compatibility
    uv pip install --system --force-reinstall torch torchvision --index-url https://download.pytorch.org/whl/cu130 && \
    uv pip install --system -e ".[export]" && \
    # Remove extra build files
    rm -rf *.whl /root/.config/RTAP/persistent_cache.json

# Usage --------------------------------------------------------------------------------------------------------------

# Production builds: 
# Example (build): t=rtap/rtap:latest-nvidia-arm64 && docker build --platform linux/arm64 -f docker/Dockerfile-nvidia-arm64 -t $t .
# Example (push): docker push $t
# Example (pull): t=rtap/rtap:latest-nvidia-arm64 && docker pull $t
# Example (run-dgx-spark): docker run -it --ipc=host --device nvidia.com/gpu=all $t
# Example (run-dgx-spark-with-volume): docker run -it --ipc=host --device nvidia.com/gpu=all -v "$PWD/shared/datasets:/datasets" $t
# Example (run-jetson-thor): docker run -it --ipc=host --runtime=nvidia $t
# Example (run-jetson-thor-with-volume): docker run -it --ipc=host --runtime=nvidia -v "$PWD/shared/datasets:/datasets" $t
# CDI requires Docker >= 28.2.0 and nvidia-container-toolkit >= 1.18.
# Legacy --gpus all can lose GPU access after host systemd daemon reloads (nvidia-container-toolkit#48).
