# RTAP — Real-Time Autonomous Perception (AGPL-3.0)

# Builds rtap/rtap:latest-python image on DockerHub 
# Lightweight CPU image optimized for YOLO inference

FROM python:3.13-slim-trixie

# Set environment variables (suppress PyTorch NNPACK warnings)
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    UV_BREAK_SYSTEM_PACKAGES=1 \
    TORCH_CPP_LOG_LEVEL=ERROR

# Downloads to user config dir
ADD  \
     \
    /root/.config/RTAP/

# Install linux packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    python3-pip git zip unzip wget curl htop libgl1 libglib2.0-0 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Create working directory
WORKDIR /rtap

# Copy contents and configure dependencies
COPY . .
RUN sed -i'' -e 's/"opencv-python/"opencv-python-headless/' pyproject.toml
ADD  .

# Install pip packages
RUN pip install uv && \
    uv pip install --system --no-cache -e . \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    --index-strategy unsafe-best-match && \
    rm -rf tmp ~/.cache /root/.config/RTAP/persistent_cache.json

# Usage --------------------------------------------------------------------------------------------------------------

# Production builds: 
# Example (build): t=rtap/rtap:latest-python && docker build -f docker/Dockerfile-python -t $t .
# Example (push): docker push $t
# Example (pull): t=rtap/rtap:latest-python && docker pull $t
# Example (run): docker run -it --ipc=host $t
# Example (run-with-volume): docker run -it --ipc=host -v "$PWD/shared/datasets:/datasets" $t
